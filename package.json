{
  "name": "@yadimon/prio-llm-router",
  "version": "0.7.6",
  "description": "Deterministic priority and fallback routing for text generation across Vercel AI SDK providers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e:real": "node ./scripts/e2e/real-providers.mjs",
    "pack": "npm pack --dry-run",
    "pack:check": "npm run pack && publint",
    "publish:dry-run": "npm publish --dry-run",
    "smoke:published": "node ./scripts/smoke-published.mjs",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run pack:check && npm run publish:dry-run"
  },
  "keywords": [
    "llm",
    "router",
    "fallback",
    "gemini",
    "google",
    "openrouter",
    "groq",
    "mistral",
    "cohere",
    "perplexity",
    "xai",
    "togetherai",
    "openai",
    "anthropic",
    "deepseek",
    "vercel-ai-sdk",
    "ai-sdk",
    "ai-gateway",
    "openai-compatible",
    "streaming",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yadimon/prio-llm-router.git"
  },
  "homepage": "https://github.com/yadimon/prio-llm-router#readme",
  "bugs": {
    "url": "https://github.com/yadimon/prio-llm-router/issues"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/cohere": "^4.0.37",
    "@ai-sdk/deepseek": "^3.0.39",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/mistral": "^4.0.39",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ai-sdk/perplexity": "^4.0.39",
    "@ai-sdk/togetherai": "^3.0.45",
    "@ai-sdk/xai": "^4.0.54",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.93"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
